# ─────────────────────────────────────────────
# Server & Environment
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=PGBooking
APP_VERSION=1.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─────────────────────────────────────────────
# Database (PostgreSQL - Supabase)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:Manojjaat%402005@db.pinrxvmrvefcjkvjmumf.supabase.co:5432/postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=true

# ─────────────────────────────────────────────
# Redis (Upstash)
# ─────────────────────────────────────────────
REDIS_URL=rediss://default:gQAAAAAAAgQ1AAIgcDExYWUyMDFmNDQ3MjQ0NzA5YjY1N2MwZmJmZjAwYTk1Zg@stirred-seahorse-132149.upstash.io:6379

# ─────────────────────────────────────────────
# JWT Security (RS256 generated)
# ─────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
JWT_ISSUER=pgbooking-api
JWT_AUDIENCE=pgbooking-client

# ─────────────────────────────────────────────
# Encryption Key (AES-256-GCM 32-byte)
# ─────────────────────────────────────────────
ENCRYPTION_KEY=9b702904021510730b3b5c5d4af8c2ae324037eba25087f610d9894fd85bafe3

# ─────────────────────────────────────────────
# Supabase S3 Storage
# ─────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_STORAGE_SECRET
AWS_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_S3_BUCKET_KYC=pgbooking-kyc
AWS_S3_BUCKET_PROPERTIES=pgbooking-properties
AWS_S3_BUCKET_MAINTENANCE=pgbooking-maintenance
AWS_S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ─────────────────────────────────────────────
# Razorpay Payments (Test Mode)
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=mysecretwebhook123

# ─────────────────────────────────────────────
# OTP / SMS (Mocked for dev/console log)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACfakevalue
TWILIO_AUTH_TOKEN=fakevalue
TWILIO_PHONE_NUMBER=+15005550006

# ─────────────────────────────────────────────
# Firebase Push Notifications
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_PRIVATE_KEY_ID=YOUR_FIREBASE_PRIVATE_KEY_ID
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-dummy@pgbooking.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=YOUR_FIREBASE_CLIENT_ID

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dummy
SMTP_PASSWORD=dummy
EMAIL_FROM=noreply@pgbooking.local

# ─────────────────────────────────────────────
# Rate Limiting & Upload
# ─────────────────────────────────────────────
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
BOOKING_LOCK_TTL_MS=600000
BULLMQ_CONCURRENCY=3
